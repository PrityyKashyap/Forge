<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.forge</groupId>
        <artifactId>forge</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>forge-cluster</artifactId>
    <name>forge-cluster</name>
    <description>
        Cluster-level concerns spanning multiple nodes: the partition map
        and consistent hashing, membership and failure detection, and
        replication.
    </description>

    <dependencies>
        <dependency>
            <groupId>com.forge</groupId>
            <artifactId>forge-common</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.forge</groupId>
            <artifactId>forge-storage</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.forge</groupId>
            <artifactId>forge-server</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.forge</groupId>
            <artifactId>forge-client</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <configuration>
                    <!-- The multi-node cluster launcher (see com.forge.cluster.launcher.ClusterNodeMain's
                         own Javadoc). Run with:
                         mvn -pl forge-cluster exec:java -Dexec.args="<clusterConfigFile> <selfNodeId> <dataDirectory>"
                         Maven resolves the full runtime classpath, including this module's own
                         logback-classic dependency below (compile scope, matching forge-server's
                         identical declaration; it must not be test-scoped, since ClusterNodeMain is
                         a real runtime entry point, not test code). Never construct this classpath
                         by hand with a manual java -cp command. -->
                    <mainClass>com.forge.cluster.launcher.ClusterNodeMain</mainClass>
                    <classpathScope>compile</classpathScope>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
